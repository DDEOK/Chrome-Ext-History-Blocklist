{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "version": "2.0.0",
  "default_locale": "en",
  "_comment_key": "압축해제 로드에서 확장 ID 를 고정해 기기 간 설정 동기화를 유지한다. 공개키라 공개돼도 무해하다. 웹스토어는 자체 키를 발급하므로 tools/package.py 가 스토어용 zip 에서 이 필드를 뺀다.",
  "key": "",
  "description": "__MSG_appDesc__",
  "permissions": ["history", "storage", "alarms", "activeTab"],
  "omnibox": { "keyword": "hb" },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "__MSG_appName__",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
